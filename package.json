{
  "name": "talo",
  "version": "0.0.0",
  "private": true,
  "description": "Talo: partnership intelligence, built by Somehow Internet.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write",
    "schema": "tsx scripts/generate-schema.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:research": "tsx scripts/check-research.ts",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "npm run build:app && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run build:app && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "data:audit": "tsx scripts/data-audit.ts",
    "registry:import": "tsx scripts/registry-import.ts",
    "sources:seed": "tsx scripts/sources-seed.ts",
    "admin:key": "tsx scripts/admin-key.ts",
    "review": "tsx scripts/review.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "dev:app": "vite build --config app/vite.config.ts --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.50.0",
    "@solana/kit": "8.6.0",
    "@stripe/stripe-js": "1.54.2",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
