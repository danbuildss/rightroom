{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:app",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "getrightroom.co"
        }
      ],
      "destination": "https://app.getrightroom.co/app/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "getrightroom.co"
        }
      ],
      "destination": "https://app.getrightroom.co/app/:path*",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        {
          "type": "host",
          "value": "www.getrightroom.co"
        }
      ],
      "destination": "https://app.getrightroom.co/app/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.getrightroom.co"
        }
      ],
      "destination": "https://app.getrightroom.co/app/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.getrightroom.co"
        }
      ],
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/:page(privacy|terms|thanks)",
      "has": [
        {
          "type": "host",
          "value": "app.getrightroom.co"
        }
      ],
      "destination": "https://getrightroom.co/:page",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rightroom.danewurum01.workers.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!app/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://auth.privy.io https://*.rpc.privy.systems; frame-src https://auth.privy.io https://challenges.cloudflare.com; child-src https://auth.privy.io https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.getrightroom.co"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": true
}
